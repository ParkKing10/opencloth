# Copy to .env and fill in your Supabase project values.
# These are FRONTEND-safe keys (publishable/anon) — data is protected by Row Level Security.
# Do NOT put the secret key or database password anywhere in the frontend.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
